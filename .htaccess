# Hostinger auto-deploys this repo into public_html, so the real site lives in
# /public. Serve it from there for chatcartpro.com ONLY (the app. and crm.
# subdomains have their own folders and must not be touched).
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# www -> apex
RewriteCond %{HTTP_HOST} ^www\.chatcartpro\.com$ [NC]
RewriteRule ^ https://chatcartpro.com%{REQUEST_URI} [R=301,L]

# Old extension URLs (/pricing.html) -> clean URLs (/pricing/)
RewriteCond %{HTTP_HOST} ^chatcartpro\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/index\.html$
RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{DOCUMENT_ROOT}/public/$1/index.html -f
RewriteRule ^([^/]+)\.html$ /$1/ [R=301,L]

# /pricing -> /pricing/ (add the trailing slash before the internal rewrite)
RewriteCond %{HTTP_HOST} ^chatcartpro\.com$ [NC]
RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

# Everything else is served from /public (so /docs, /tools, /deploy are not web-reachable)
RewriteCond %{HTTP_HOST} ^chatcartpro\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/x-icon "access plus 30 days"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
</IfModule>
